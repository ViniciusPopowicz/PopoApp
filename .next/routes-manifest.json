{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/attachments/[id]",
      "regex": "^/api/attachments/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/attachments/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/clients/[id]",
      "regex": "^/api/clients/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/clients/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/clients/[id]/contacts",
      "regex": "^/api/clients/([^/]+?)/contacts(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/clients/(?<nxtPid>[^/]+?)/contacts(?:/)?$"
    },
    {
      "page": "/api/clients/[id]/contacts/[contactId]",
      "regex": "^/api/clients/([^/]+?)/contacts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPcontactId": "nxtPcontactId"
      },
      "namedRegex": "^/api/clients/(?<nxtPid>[^/]+?)/contacts/(?<nxtPcontactId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/clients/[id]/photo",
      "regex": "^/api/clients/([^/]+?)/photo(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/clients/(?<nxtPid>[^/]+?)/photo(?:/)?$"
    },
    {
      "page": "/api/procedures/[id]",
      "regex": "^/api/procedures/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/procedures/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/agenda",
      "regex": "^/agenda(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/agenda(?:/)?$"
    },
    {
      "page": "/atendimentos",
      "regex": "^/atendimentos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/atendimentos(?:/)?$"
    },
    {
      "page": "/clientes",
      "regex": "^/clientes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clientes(?:/)?$"
    },
    {
      "page": "/financeiro",
      "regex": "^/financeiro(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/financeiro(?:/)?$"
    },
    {
      "page": "/lembretes",
      "regex": "^/lembretes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lembretes(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/procedimentos",
      "regex": "^/procedimentos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/procedimentos(?:/)?$"
    },
    {
      "page": "/produtos",
      "regex": "^/produtos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/produtos(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}